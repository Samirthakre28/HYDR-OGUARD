PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=

# Optional AI Explanation Provider Configuration
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Real-Time Weather Integration (Step 9)
# Optional: Open-Meteo works by default without an API key. Custom weather providers can be specified here.
WEATHER_API_KEY=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_MS=300000

# Hydrological / River Level Integration (Step 11)
# Optional: Open-Meteo Flood / GloFAS API works by default without an API key.
HYDRO_API_KEY=
HYDRO_API_URL=https://flood-api.open-meteo.com/v1/flood
HYDRO_CACHE_TTL_MS=300000

# Seismic Activity Integration (Step 12)
# Public USGS Earthquake Catalog API (No API key required)
SEISMIC_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
SEISMIC_RADIUS_KM=100
SEISMIC_LOOKBACK_HOURS=24
SEISMIC_CACHE_TTL_MS=300000

# Deterministic Demo Mode (Step 20)
DEMO_MODE=false

# Security & Rate Limiting Hardening (Step 21)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_SENSITIVE_MAX=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Future ML Architecture (Step 22 - Safe Defaults)
# Options: disabled | shadow | candidate | production (requires validated model)
ML_MODE=disabled
ML_MODEL_ID=
ML_MODEL_VERSION=



